#include <iostream>     // Подключаем библиотеку для ввода и вывода
#include <fstream>      // Подключаем библиотеку для работы с файлами
#include <string>       // Подключаем библиотеку для работы со строками
#include <thread>       // Подключаем библиотеку для работы с потоками
#include <chrono>       // Подключаем библиотеку для работы со временем

using namespace std;    // Позволяет использовать стандартные объекты без std::

int main() {            // Главная функция программы

    // Путь к файлу, в который клиент записывает вес и рост
    string filename1 = "..\\..\\klient.txt";

    // Путь к файлу, из которого клиент получает результат
    string filename2 = "..\\..\\server.txt";

    // Объявляем переменные для веса и роста
    double ves, rost;

    // Просим пользователя ввести вес
    cout << "Enter ves (kg): ";

    // Считываем введённый вес с клавиатуры
    cin >> ves;

    // Просим пользователя ввести рост
    cout << "Enter rost (m): ";

    // Считываем введённый рост с клавиатуры
    cin >> rost;

    // Открываем klient.txt для записи
    ofstream out(filename1);

    // Проверяем, удалось ли открыть файл
    if (!out.is_open()) {

        // Если файл открыть не удалось, выводим сообщение об ошибке
        cerr << "Wrong\n";

        // Завершаем программу с кодом ошибки 1
        return 1;
    }

    // Записываем вес и рост в файл
    // Между ними ставим пробел
    // Например: 74.6 1.82
    out << ves << " " << rost << "\n";

    // Закрываем klient.txt
    out.close();

    // Переменная для хранения ИМТ, который вернёт сервер
    double imt;

    // Флаг, показывающий, получили ли мы результат
    // Изначально результата нет, поэтому false
    bool est_result = false;

    // Максимум 20 раз проверяем наличие результата
    for (int i = 0; i < 20; ++i) {

        // Открываем server.txt для чтения
        ifstream in(filename2);

        // Проверяем, удалось ли открыть server.txt
        if (in.is_open()) {

            // Перемещаем позицию чтения в начало файла
            in.seekg(0);

            // Считываем ИМТ из файла
            in >> imt;

            // Сообщаем программе, что результат получен
            est_result = true;

            // Закрываем server.txt
            in.close();
        }

        // Если результат уже получен
        if (est_result)

            // Выходим из цикла for
            break;

        // Если результата пока нет,
        // ждём 500 миллисекунд (0,5 секунды)
        this_thread::sleep_for(chrono::milliseconds(500));
    }

    // Проверяем, удалось ли получить результат
    if (est_result) {

        // Выводим рассчитанный ИМТ на экран
        cout << "BMI = " << imt << "\n";
    }
    else {

        // Если за время ожидания результат не получен,
        // выводим сообщение об этом
        cout << "Net resultata\n";
    }
}
